generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// Main Job Creation Schema 
model PostJob {
  id String @id @default(cuid())
  roleTitle String
  companyName String
  employmentType String
  location String

  url String?

  //tip tap field
  description String?

  userId String? //comes from mongodb
  companyId String? //comes from mongodb

  draftStats String? @default("draft")
  status String? @default("pending")

  approvals JobApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobApproval{ 
  
  id String @id @default(cuid())
  jobId String
  leadId String
  leadName String

  action String
  reason String?
  createdAt DateTime @default(now())

  job PostJob @relation(fields: [jobId], references: [id])
}

model CommunityPost {
  id String @id @default(cuid())

  title String?
  content String
  images String[]

  postedUser String
  anonymousName String
  anonymousAvatar String

  likes Int?
  comments CommentPost[]
  likedBy String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model CommentPost {
  id String @id @default(cuid())

  content String

  postId String
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String

  createdAt DateTime @default(now())
}
